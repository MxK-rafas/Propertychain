# Configuração PÚBLICA para frontend/.env.local ou Vercel.
# App funcional publicado; somente Solana Devnet.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Nunca inserir token secreto em VITE_*: variáveis do frontend são públicas.
# Não há chave privada de deploy. O usuário assina na Phantom.
