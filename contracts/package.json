{
  "name": "propertychain-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato DocumentRegistry do Propertychain (protótipo educacional, sem valor legal)",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "coverage:check": "node scripts/check-coverage.cjs",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy-local.cjs --network localhost",
    "seed:local": "hardhat run scripts/seed-local.cjs --network localhost",
    "test:local": "node --test integration/local-flow.test.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.29.1",
    "istanbul-lib-coverage": "^3.2.2"
  }
}
